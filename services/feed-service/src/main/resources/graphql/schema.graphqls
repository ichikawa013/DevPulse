type Post {
    id: ID!
    content: String!
    imageUrl: String
    authorEmail: String!
    createdAt: String!
}

input CreatePostInput {
    imageUrl: String
    content: String!
}

type PostEdge {
    node: Post!
    cursor: String!
}

type PageInfo {
    hasNextPage: Boolean!
    endCursor: String
}

type Subscription {
    postCreated: Post!
}

type PostConnection {
    edges: [PostEdge!]!
    pageInfo: PageInfo!
}

enum ReactionType {
LIKE
CELEBRATE
INSIGHTFUL
CURIOUS
}

type Reaction {
id: ID!
postId: ID!
actorEmail: String!
reactionType: ReactionType!
createdAt: String!
}

type Mutation {
    createPost(input: CreatePostInput!) : Post!
    deletePost(id: ID!) : Boolean!
    reactPost(postId: ID!, reactionType: ReactionType!): Reaction!
}

type Query {
    feed(first: Int!, after: String): PostConnection!
}